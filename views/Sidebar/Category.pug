li#category.el(x-data='category')
  | [##_category_list_##]

script.
  document.addEventListener('alpine:init', () => Alpine.data('category', () => ({
    /**
     * @var {Boolean} foldableCategory
     */
    foldableCategory: skinOptions.foldableCategory,

    /**
     * Section map (Section name → category slugs)
     *
     * @var {Object.<string, string[]>}
     */
    sectionMap: {
      'Development':      ['Embedded', 'Language', 'Web'],
      'Computer Science': ['OS', 'Network', 'Algorithm'],
      'Tools & Infra':    ['DevTools', 'Infra', 'Cloud'],
      'Works':            ['Projects', 'Experience', '블로그'],
      '취미':             ['Coffee', 'Motion']
    },

    /**
     * Init
     */
    init () {
      this.sectionLayer()

      if (this.foldableCategory) {
        this.$subCategories.forEach(this.foldable.bind(this))
      }
    },

    /**
     * Insert section headers between top-level category items
     */
    sectionLayer () {
      const $list = this.$categoryList

      if (!$list) return

      let prevSection = null

      Array.from($list.children).forEach($li => {
        const $link = $li.querySelector('.link_item')

        if (!$link) return

        const slug = decodeURIComponent($link.getAttribute('href').split('/').pop())
        const section = this.findSection(slug)

        if (section && section !== prevSection) {
          const $header = document.createElement('li')

          $header.classList.add('section-header')
          $header.textContent = section
          $header.setAttribute('aria-hidden', 'true')

          $list.insertBefore($header, $li)
          prevSection = section
        }
      })
    },

    /**
     * Find section name for a category slug
     *
     * @param {String} slug
     * @returns {String|null}
     */
    findSection (slug) {
      for (const section in this.sectionMap) {
        if (this.sectionMap[section].includes(slug)) return section
      }
      return null
    },

    /**
     * Foldable
     *
     * @param {HTMLElement} $subCategory
     */
    foldable ($subCategory) {
      $subCategory.parentNode.setAttribute('x-data', '{ open: false }')
      $subCategory.setAttribute('x-show', 'open')
      $subCategory.setAttribute('x-collapse', '')

      const $icon = this.$icon

      $icon.setAttribute('x-on:click', 'open = ! open')
      $icon.setAttribute(':class', '{ "rotate-90 duration-200": open }')

      $subCategory.parentNode.prepend($icon)
    },

    /**
     * Get the top-level category list
     *
     * @var {HTMLElement|null} $categoryList
     */
    get $categoryList () {
      return this.$el.querySelector('.tt_category > li > .category_list')
    },

    /**
     * Get subcategories
     *
     * @var {NodeListOf<HTMLElement>} $subCategories
     */
    get $subCategories () {
      return this.$el.querySelectorAll('.sub_category_list')
    },

    /**
     * Get a new icon
     *
     * @var {HTMLElement} $icon
     */
    get $icon () {
      const icon = document.createElement('i')

      icon.classList.add('fa-solid', 'fa-chevron-right')

      return icon
    }
  })))

style
  :postcss
    #category {
      .tt_category {
        .link_tit,
        .link_item,
        .link_sub_item {
          img {
            @apply hidden;
          }

          .c_cnt {
            @apply text-xs;
          }
        }

        .link_tit {
          @apply text-sm font-bold mb-6 inline-block text-h-900 dark:text-h-200;
        }

        ul {
          @apply flex flex-col gap-y-4 text-sm;

          li {
            @apply relative pr-5;

            i {
              @apply absolute right-0 text-2xs cursor-pointer leading-5;
            }
          }
        }

        .sub_category_list {
          li {
            @apply first:mt-4;

            .link_sub_item::before {
              @apply relative -top-0.5 mr-1 fa-chevron-right text-2xs font-bold text-h-400;
            }
          }
        }

        .section-header {
          @apply text-xs font-semibold tracking-wider text-h-500 dark:text-h-400;
          @apply mt-6 mb-2 pointer-events-none;
        }

        .section-header:first-child {
          @apply mt-0;
        }
      }
    }
