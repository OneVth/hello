article#article(x-ref='article')
  | #{`[##_${type}_rep_desc_##]`}
  include PostBtn/Subscription

style(once='article')
  :postcss
    #article {
      .contents_style {
        @apply text-left p-0 leading-loose text-h-600 dark:text-h-200;

        a {
          @apply text-h-orange dark:text-h-blue decoration-0;
        }

        h2,
        h3,
        h4 {
          @apply my-5 font-medium scroll-mt-20;

          a {
            @apply text-h-600 dark:text-h-200;
          }
        }

        h2 {
          @apply text-xl lg:text-2xl;
        }

        h3 {
          @apply text-lg lg:text-xl;
        }

        h4 {
          @apply text-base lg:text-lg;
        }

        ol[data-ke-list-type],
        ul[data-ke-list-type],
        ol:not([data-ke-list-type]),
        ul:not([data-ke-list-type]) {
          @apply flex flex-col gap-y-1 pl-[1.1rem] my-5;
          list-style: revert;

          ol[data-ke-list-type],
          ul[data-ke-list-type],
          ol:not([data-ke-list-type]),
          ul:not([data-ke-list-type]) {
            @apply my-0 ml-6;
          }
        }

        p,
        ol[data-ke-list-type],
        ul[data-ke-list-type],
        table[data-ke-align],
        blockquote[data-ke-style=style2],
        blockquote[data-ke-style=style3] {
          @apply text-h-600 dark:text-h-300;

          b,
          strong {
            @apply font-bold;
          }

          a {
            @apply inline-block text-h-orange dark:text-h-blue;
          }

          code:not(:where(pre *)) {
            @apply rounded-md relative -top-[1px] px-1.5 py-0.5 whitespace-normal text-sm font-sans text-h-orange bg-h-200;
            @apply dark:text-h-blue dark:bg-h-700;
          }
        }

        figure,
        pre,
        table[data-ke-align],
        [data-ke-type=moreLess] {
          @apply my-5;
        }

        hr[data-ke-style] {
          @apply dark:invert dark:brightness-0;
        }

        table[data-ke-align] {
          td,
          th {
            @apply bg-transparent border-0 border-b border-solid border-h-300 px-3 py-4 box-border text-sm leading-loose text-h-600;
            @apply dark:text-h-200 dark:border-h-600;

            figure {
              &.imageblock.alignCenter {
                @apply w-full !important;
              }
            }
          }
        }

        figure {
          figcaption {
            @apply text-h-400 text-center text-sm leading-loose;
          }

          &.imageblock.alignCenter,
          &.imagegridblock {
            @apply max-lg:w-full !important;
          }

          &[data-ke-type=opengraph] {
            a {
              @apply border-0;

              .og-image {
                @apply border-r-0 rounded-l-md overflow-hidden;
              }
            }

            .og-text {
              @apply bg-h-200 dark:bg-h-700 rounded-r-md;

              .og-title,
              .og-desc,
              .og-host {
                @apply text-h-500 dark:text-h-200 font-sans;
              }

              .og-title {
                @apply text-h-600 font-bold;
              }
            }
          }

          &.fileblock {
            @apply border-0 bg-h-200 dark:bg-h-700;

            .filename {
              @apply mt-3;

              .name {
                @apply h-auto;
              }
            }

            .filename,
            .size {
              @apply dark:text-h-200;
            }

            .image,
            a::after {
              @apply dark:invert dark:brightness-0;
            }
          }
        }

        [data-ke-type=moreLess] {
          @apply relative;

          &::before {
            @apply content-[''] absolute top-4 right-0 w-full h-0 w-full -z-[1] border-b border-dashed border-h-300 dark:border-h-600;
          }

          &.open {
            .btn-toggle-moreless::before {
              @apply fa-circle-arrow-down;
            }
          }

          .btn-toggle-moreless {
            @apply bg-h-700 text-h-200 text-xs font-bold rounded-md px-3 py-2 inline-block !important;

            &::before {
              @apply mr-1.5 fa-circle-arrow-right;
            }
          }

          .moreless-content {
            @apply mt-6;
          }
        }

        blockquote[data-ke-style] {
          @apply font-[initial] my-4 text-h-600 dark:text-h-200 font-sans;

          &[data-ke-style=style1] {
            @apply font-medium text-xl pt-7 leading-loose text-h-600 dark:text-h-200;
          }

          &[data-ke-style=style2] {
            @apply border-l-2 border-solid border-h-300 dark:border-h-600 pl-3 pr-1 text-h-400 text-left text-sm leading-loose;
          }

          &[data-ke-style=style3] {
            @apply p-5 rounded-md border-0 text-h-400 bg-h-200 dark:bg-h-700 dark:text-h-400 leading-loose;
          }
        }

        /* Tistory global injection reset (Ray-pattern + hELLO extension) */
        blockquote,
        q {
          quotes: none;
        }

        blockquote::before,
        blockquote::after,
        q::before,
        q::after {
          content: none !important;
        }

        blockquote {
          background-image: none !important;
          text-align: revert !important;
          color: revert !important;
        }

        pre {
          code {
            @apply rounded-md p-4 text-sm leading-relaxed;

            &.hljs {
              @apply bg-h-200 dark:bg-h-700;
            }
          }
        }

        /* callout palette (Obsidian flexcyon) */
        --co-blue:   92, 159, 228;
        --co-cyan:   59, 155, 161;
        --co-green:  104, 149, 35;
        --co-orange: 237, 129, 38;
        --co-red:    235, 83, 87;
        --co-purple: 111, 73, 174;
        --co-gray:   158, 158, 158;

        blockquote.markdown-callout,
        blockquote[data-ke-style].markdown-callout {
          @apply my-4 font-sans text-base font-normal;
          padding: 12px 24px;
          border-radius: 2px;
          border-left: 4px solid rgb(var(--co-blue));
          background-color: rgba(var(--co-blue), 0.1);
          line-height: 1.75;

          .callout-title {
            @apply font-bold text-base;
            color: rgb(var(--co-blue));
            display: flex;
            align-items: center;
            gap: 4px;
            margin-bottom: 0.25em;

            &::before {
              @apply font-awesome font-bold;
              content: '\f303';
              width: 1.2em;
              text-align: center;
            }
          }

          p:not(.callout-title) {
            @apply text-h-600 dark:text-h-200;
            margin: 0.25em 0;
          }
        }

        blockquote.markdown-callout-note,
        blockquote[data-ke-style].markdown-callout-note {
          border-left-color: rgb(var(--co-blue));
          background-color: rgba(var(--co-blue), 0.1);
          .callout-title { color: rgb(var(--co-blue)); &::before { content: '\f303'; } }
        }

        blockquote.markdown-callout-tip,
        blockquote[data-ke-style].markdown-callout-tip {
          border-left-color: rgb(var(--co-cyan));
          background-color: rgba(var(--co-cyan), 0.1);
          .callout-title { color: rgb(var(--co-cyan)); &::before { content: '\f0eb'; } }
        }

        blockquote.markdown-callout-important,
        blockquote[data-ke-style].markdown-callout-important {
          border-left-color: rgb(var(--co-cyan));
          background-color: rgba(var(--co-cyan), 0.1);
          .callout-title { color: rgb(var(--co-cyan)); &::before { content: '\f06a'; } }
        }

        blockquote.markdown-callout-warning,
        blockquote[data-ke-style].markdown-callout-warning {
          border-left-color: rgb(var(--co-orange));
          background-color: rgba(var(--co-orange), 0.1);
          .callout-title { color: rgb(var(--co-orange)); &::before { content: '\f071'; } }
        }

        blockquote.markdown-callout-danger,
        blockquote[data-ke-style].markdown-callout-danger {
          border-left-color: rgb(var(--co-red));
          background-color: rgba(var(--co-red), 0.1);
          .callout-title { color: rgb(var(--co-red)); &::before { content: '\f06d'; } }
        }

        blockquote.markdown-callout-example,
        blockquote[data-ke-style].markdown-callout-example {
          border-left-color: rgb(var(--co-purple));
          background-color: rgba(var(--co-purple), 0.1);
          .callout-title { color: rgb(var(--co-purple)); &::before { content: '\f0c3'; } }
        }

        blockquote.markdown-callout-success,
        blockquote[data-ke-style].markdown-callout-success {
          border-left-color: rgb(var(--co-green));
          background-color: rgba(var(--co-green), 0.1);
          .callout-title { color: rgb(var(--co-green)); &::before { content: '\f058'; } }
        }

        blockquote.markdown-callout-quote,
        blockquote[data-ke-style].markdown-callout-quote {
          border-left-color: rgb(var(--co-gray));
          background-color: rgba(var(--co-gray), 0.1);
          .callout-title { color: rgb(var(--co-gray)); &::before { content: '\f10d'; } }
        }
      }
    }

    html.dark #article .contents_style {
      --co-blue:   90, 143, 205;
      --co-cyan:   60, 185, 194;
      --co-green:  161, 192, 92;
      --co-orange: 204, 132, 73;
      --co-red:    192, 58, 71;
      --co-purple: 164, 97, 200;

      img {
        background-color: #ffffff;
      }
    }

style(once='article-postbtn')
  :postcss
    #article {
      .container_postbtn {
        @apply flex gap-x-2 p-0 pt-9 text-h-600 dark:text-h-200;

        .postbtn_like > .wrap_btn:not([id^=reaction-]) > button,
        .btn_subscription,
        .tt-btn-support {
          @apply w-9 h-9 inline-block shadow-none outline-0 rounded-md cursor-pointer duration-200 leading-none text-[0] p-0 m-0 bg-h-200 border-0 hover:bg-h-300 before:text-h-500;
          @apply dark:bg-h-700 dark:before:text-h-200 dark:hover:bg-h-600;
        }

        .postbtn_like {
          @apply border-0 p-0 flex gap-x-2;

          .wrap_btn {
            @apply inline-block border-0;

            button,
            button[data-entry-id],
            .uoc-count {
              &::before {
                @apply font-bold text-sm;
              }
            }

            .ico_like,
            .ico_share,
            .ico_statistics,
            .ico_etc {
              @apply text-hidden bg-none;
            }

            &[id^=reaction-] button {
              @apply px-3 h-9 rounded-md bg-h-700 hover:bg-h-600;

              .uoc-icon {
                @apply text-h-200;
              }

              .uoc-count {
                @apply font-bold leading-none;

                &::before {
                  @apply text-sm mr-1.5 fa-heart;
                }
              }
            }

            &.wrap_btn_share .btn_share::before {
              @apply fa-share-nodes;
            }

            button[data-entry-id] {
              &::before {
                @apply fa-chart-pie;
              }
            }

            &.wrap_btn_etc {
              .btn_etc1::before {
                @apply fa-wrench;
              }

              .btn_etc2::before {
                @apply fa-ellipsis;
              }
            }
          }
        }
      }
    }

style(once='article-tistory-ccl-layer')
  :postcss
    #tistoryCclLayer {
      @apply shadow-none border-0 bg-h-200 text-h-400 rounded-md;
      @apply dark:bg-h-700 dark:text-h-300;

      span {
        @apply text-h-400;
      }

      .ico_arrbt {
        @apply hidden;
      }
    }

style(once='article-tistory-layer')
  :postcss
    #tistorySnsLayer,
    #tistoryEtcLayer {
      @apply rounded-md shadow-none bg-h-200;
      @apply dark:bg-h-700;

      .btn_mark {
        @apply text-h-400 dark:text-h-300;

        &:hover {
          @apply bg-h-300 dark:bg-h-600 dark:text-h-200;
        }
      }

      .ico_arrbt {
        @apply hidden;
      }

      .bundle_post a {
        @apply text-h-400 dark:text-h-300 no-underline;
      }
    }
